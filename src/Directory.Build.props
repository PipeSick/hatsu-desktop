<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <!-- Versión de Hatsu Desktop (antes WinMac; docs/32 y docs/46). Se sube a mano al preparar una versión; no se publica nada automáticamente. -->
    <Version>2.0.10</Version>
    <Product>Hatsu Desktop</Product>
    <Company>Hatsu Desktop</Company>
    <Copyright>Copyright 2026 WinMac contributors — Hatsu Desktop (antes WinMac), Apache-2.0</Copyright>
    <Description>Hatsu Desktop: experiencia de escritorio inspirada en macOS para Windows.</Description>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
